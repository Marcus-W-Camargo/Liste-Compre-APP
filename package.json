{
  "name": "liste-compre-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app src tests",
    "test": "vitest run",
    "doctor": "npx expo-doctor@latest",
    "export:android": "expo export --platform android --output-dir dist/android",
    "check": "npm run typecheck && npm run lint && npm test && npm run export:android"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "0.4.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.112.4",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.2",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
